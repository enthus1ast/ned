{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Harbour",
  "author": "ned's tests (tests/unit/tthemeimport.nim)",
  "themes": [
    {
      "name": "Harbour Dusk",
      "appearance": "dark",
      "style": {
        "background": "#202b38ff",
        "border.focused": "#5fb4e8ff",
        "text": "#d8e1eaff",
        "text.accent": "#5fb4e8ff",
        "title_bar.background": "#151d27ff",
        "panel.background": "#18212cff",
        "status_bar.background": "#151d27ff",
        "editor.background": "#1b2430ff",
        "editor.foreground": "#c9d4dfff",
        "editor.wrap_guide": "#c9d4df0d",
        "editor.active_line.background": "#222d3abf",
        "error": "#f07178ff",
        "warning": "#ffcb6bff",
        "success": "#a3d08aff",
        "terminal.ansi.red": "#ff5370ff",
        "players": [
          { "cursor": "#5fb4e8ff", "background": "#5fb4e8ff", "selection": "#5fb4e83d" },
          { "cursor": "#c792eaff", "background": "#c792eaff", "selection": "#c792ea3d" }
        ],
        "syntax": {
          "comment": { "color": "#6d7d8cff", "font_style": "italic", "font_weight": null },
          "keyword": { "color": "#c792eaff", "font_style": null, "font_weight": 700 },
          "type": { "color": "#ffcb6bff", "font_style": null, "font_weight": null },
          "string": { "color": "#a3d08aff", "font_style": null, "font_weight": null },
          "number": { "color": "#3a4a5aff", "font_style": null, "font_weight": null },
          "function": { "color": "#82aaffff", "font_style": null, "font_weight": null },
          "operator": { "color": "#89ddffff", "font_style": null, "font_weight": null },
          "property": { "color": "#f78c6cff", "font_style": null, "font_weight": null },
          "punctuation": { "color": "#8fa1b3ff", "font_style": null, "font_weight": null }
        }
      }
    },
    {
      "name": "Harbour Day",
      "appearance": "light",
      "style": {
        "text.accent": "#2a6fdbff",
        "status_bar.background": "#e9eef3ff",
        "panel.background": "#eff3f7ff",
        "editor.background": "#f7f9fbff",
        "editor.foreground": "#2b3540ff",
        "editor.wrap_guide": "#2b354033",
        "error": "#c4302bff",
        "warning": "#9a6700ff",
        "created": "#2f7d32ff",
        "players": [
          { "cursor": "#2a6fdbff", "background": "#2a6fdbff", "selection": "#2a6fdb33" }
        ],
        "syntax": {
          "comment": { "color": "#6c7783", "font_style": "italic" },
          "keyword": { "color": "#8a3ab9ff", "font_weight": null },
          "type.builtin": { "color": "#a35a00ff" },
          "string": { "color": "#2f7d32ff" },
          "constant": { "color": "#b0306aff" },
          "function": { "color": "#1f5fbfff" },
          "punctuation": { "color": "#4a5560ff" },
          "variable.member": { "color": "#7a3e00ff" },
          "preproc": { "color": "#9a3d8aff" }
        }
      }
    }
