#!/usr/bin/env python3
# stand-in for `dotnet test`: [Fact] methods; names with Fail fail
import sys, re, os, glob
flt = None
a = sys.argv[1:]
if '--filter' in a: flt = a[a.index('--filter') + 1].split('~')[-1]
bad = 0
for f in glob.glob('**/*.cs', recursive=True):
    src = open(f).read()
    for m in re.finditer(r'\[(?:Fact|Theory)[^\]]*\]\s*public (?:async Task|void) (\w+)\(', src):
        n = m.group(1)
        if flt and flt != n: continue
        ok = 'Fail' not in n
        bad += not ok
        print('  %s Calc.Tests.CalcTests.%s [1 ms]' % ('Passed' if ok else 'Failed', n))
sys.exit(1 if bad else 0)
