#!/usr/bin/env python3
# stand-in for PHPUnit: --log-junit FILE [--filter X] path — tests named *Fail* fail
import sys, re
args = sys.argv[1:]
log = args[args.index('--log-junit') + 1] if '--log-junit' in args else None
flt = args[args.index('--filter') + 1] if '--filter' in args else None
path = args[-1]
src = open(path).read()
names = re.findall(r'public function (test\w+)\s*\(', src)
if flt: names = [n for n in names if re.search(flt, '::' + n)]
cases = []
for n in names:
    if 'Fail' in n: cases.append('<testcase name="%s" class="CalcTest" file="%s"><failure type="x">boom</failure></testcase>' % (n, path))
    else: cases.append('<testcase name="%s" class="CalcTest" file="%s" assertions="1"/>' % (n, path))
open(log, 'w').write('<?xml version="1.0"?>\n<testsuites><testsuite name="CalcTest">%s</testsuite></testsuites>\n' % ''.join(cases))
print('PHPUnit (stand-in): %d tests' % len(names))
sys.exit(1 if any('Fail' in n for n in names) else 0)
